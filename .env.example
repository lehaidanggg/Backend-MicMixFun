# Cổng chạy server (Railway tự động cấp biến PORT khi chạy)
PORT=3000

# Đường dẫn Cloudflare R2 Public CDN chứa 13 pack âm thanh & catalog.json
ASSET_CDN_URL=https://pub-2ec3726948d14e47babdc7ea12268a78.r2.dev

# Khóa bí mật ký HMAC Session Token & Challenge-Response chống giả mạo
AUTH_SECRET=micmixfun_hmac_secret_key_2026_v1
APP_SIGNING_SECRET=micmixfun_client_app_secret_2026

# Firebase Project ID (Điền ID project Firebase của bạn để bật kiểm tra chữ ký RSA-SHA256 nghiêm ngặt)
FIREBASE_PROJECT_ID=

# Giới hạn số kết nối Socket.IO tối đa trên mỗi địa chỉ IP
MAX_CONNECTIONS_PER_IP=15
